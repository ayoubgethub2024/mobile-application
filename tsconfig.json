{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "react",
      "react-native",
      "expo"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "app",
    "providers",
    "components",
    "constants",
    "hooks",
    "scripts"
, "lib/utils"  ]
}
